# Use the existing Horizon Railway PostgreSQL database; no application tables are copied.
DATABASE_PROVIDER=railway
DATABASE_URL=
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=4
# Optional separate read-only database credential for analytics.
ANALYTICS_DATABASE_URL=
# Use the same >=32-character session secret as Horizon. Never use NEXT_PUBLIC_*.
ADMIN_SESSION_SECRET=
APP_ORIGIN=http://localhost:3100
# Main Horizon origin used by admin website previews to load generated media.
HORIZON_PUBLIC_ORIGIN=https://horizon.cognilune.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3100/api/auth/google/callback
# Optional local-development import; see scripts/with-horizon-env.mjs.
# No development auth bypass is supported.
